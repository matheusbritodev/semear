# Sistema Semear — copie para .env (na raiz) e preencha. NUNCA commitar o .env.
# Onde achar cada valor: docs/06-supabase-conexao.md
#
# Um único arquivo para a aplicação inteira:
#   - Spring Boot (Model/Controller) lê todas as variáveis;
#   - Vite (View) só expõe ao navegador as que começam com VITE_.
# Por isso NUNCA coloque segredo em variável VITE_.

# ---------- Supabase ----------
SUPABASE_URL=

# Banco: Session pooler, porta 5432 (botão "Connect" no painel do Supabase)
SUPABASE_DB_URL=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
DB_POOL_MAX=5

# Chave secreta (sb_secret_...): Admin API do Auth e Storage. Só no servidor!
SUPABASE_SECRET_KEY=

# ---------- Aplicação ----------
SERVER_PORT=8080
CORS_ORIGENS=http://localhost:5173

# Integração Cora: falso | sandbox | producao
CORA_MODO=falso
# Segredo do webhook (HMAC-SHA256 do corpo, cabeçalho X-Cora-Assinatura). Gere um valor aleatório longo.
CORA_WEBHOOK_SEGREDO=
# Tarefas agendadas do financeiro (boletos, avisos, rotina diária): true | false
SEMEAR_JOBS_ATIVOS=true

# ---------- View (vai para o navegador) ----------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=/api
